{
  "name": "pointer-ide",
  "productName": "Pointer",
  "version": "1.0.0",
  "description": "Pointer — an AI-first code editor with a real coding agent, powered by Google Gemini and Groq.",
  "author": "Pointer",
  "license": "MIT",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env POINTER_DEV=1 electron .\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist:win": "npm run build:renderer && node scripts/prepare-win.js && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "chokidar": "^5.0.0",
    "picomatch": "^4.0.7",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.pointer.ide",
    "productName": "Pointer",
    "copyright": "Copyright © 2026 Pointer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@lydell/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Pointer"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pointer",
      "artifactName": "Pointer-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Pointer-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    }
  }
}
